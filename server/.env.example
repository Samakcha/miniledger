# Server configuration
PORT=5001

# PostgreSQL database connection URL (Prisma)
# Replace placeholder credentials with your actual PostgreSQL credentials
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/miniledger?schema=public"

# JWT secret for authentication
# Replace with a strong, random secret in production
JWT_SECRET="your-jwt-secret-key-here"

# Demo OTP mode toggle (disabled by default)
# When set to true, allows reviewers to authenticate using the demo OTP (123456)
DEMO_OTP_ENABLED=false
